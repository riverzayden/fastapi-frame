# .env 로 복사해서 쓰세요. 코드 수정 없이 배포별로 조절됩니다.
# 값의 정의는 app/config.py 한 곳에 모여 있습니다.

# ── 실행 시간 제한 ────────────────────────────────
FOLLOWUP_JOB_TIMEOUT_SEC=3600
FOLLOWUP_REAL_TIMEOUT_SEC=300
FOLLOWUP_CANCEL_GRACE_SEC=30

# ── 워커 ──────────────────────────────────────────
FOLLOWUP_JOB_MAX_WORKERS=16
FOLLOWUP_JOB_MAX_ATTEMPTS=3

# ── 상태 / 복구 ───────────────────────────────────
FOLLOWUP_HEARTBEAT_INTERVAL_SEC=30
FOLLOWUP_STALE_AFTER_SEC=120
FOLLOWUP_WATCHDOG_INTERVAL_SEC=10
FOLLOWUP_RECOVER_ON_STARTUP=true
FOLLOWUP_RECOVER_BATCH_SIZE=500

# ── DB ────────────────────────────────────────────
FOLLOWUP_DB_PATH=followup.db
FOLLOWUP_DB_TIMEOUT_SEC=30

# ── 그림 (matplotlib) ─────────────────────────────
FOLLOWUP_PLOT_DPI=100
FOLLOWUP_PLOT_FONT_SIZE=10
FOLLOWUP_PLOT_OUTPUT_DIR=output/plots
